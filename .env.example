# ═══════════════════════════════════════════════════════════════════════════
# talentOS Production Environment Variables
# Copy this file to .env, fill in all values, and NEVER commit .env
# ═══════════════════════════════════════════════════════════════════════════

# ── Linode ──────────────────────────────────────────────────────────────────
LINODE_PUBLIC_IP=change-me-to-your-linode-ip
CORS_ALLOW_ORIGINS=https://your-domain.com
FRONTEND_BASE_URL=https://your-domain.com
VITE_APP_URL=https://your-domain.com


# ── App Config ──────────────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── Database (Local Postgres) ───────────────────────────────────────────────
DATABASE_URL=postgresql://talentos:change_me@postgres:5432/talentos

POSTGRES_USER=talentos
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=talentos

# ── Supabase (used ONLY for one-time data migration to local Postgres) ───────
SUPABASE_URL=postgresql://postgres:password@aws-0.ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WEBHOOK_SECRET=
SUPABASE_FUNCTIONS_BASE_URL=https://xxxxx.supabase.co/functions/v1

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key
MODEL_NAME=gpt-5.4-mini
EVALUATION_MODEL_NAME=gpt-5.4-nano

# ── Google OAuth (user login) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=

# ── Google Calendar (service account with domain-wide delegation) ───────────
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATION_EMAIL=
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# ── JWT (used for session/auth tokens) ──────────────────────────────────────
JWT_SECRET=generate-a-random-secret-at-least-32-chars

# ── SMTP / Email ────────────────────────────────────────────────────────────
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
