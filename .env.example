# ═══════════════════════════════════════════════════════════════════════════
# talentOS Production Environment Variables
# Copy this file to `.env` on the Linode. It is the **OpenBao seed only**.
# App containers (be, workers, ai) do NOT load this file — they fetch values
# from OpenBao at startup (BAO_REQUIRED=true).
#
# Rotating a secret: change it here, then `docker compose up -d openbao be ai`.

# ── OpenBao: local-dev token bootstrap (gatekeeper-managed) ────────────────
# Devs fetch scoped app tokens (NO SSH access) from:
#   https://<domain>/bao-token/be.token  and  .../bao-token/ai.token
# protected by basic-auth (below) + an nginx IP allowlist. The allowlist is
# built from BAO_TOKEN_ALLOWED_IPS (space-separated IPs/CIDRs of dev machines;
# each dev gets theirs from `curl ifconfig.me`). On any IP change, update THIS
# file and re-run `bash scripts/deploy.sh` — always edit .env, never the
# generated .bao-allowlist.conf / .bao-htpasswd directly (deploy overwrites).
BAO_TOKEN_USER=bao
BAO_TOKEN_PASS=change-me
BAO_TOKEN_ALLOWED_IPS="1.2.3.4 203.0.113.0/24"

# ── Linode ──────────────────────────────────────────────────────────────────
LINODE_PUBLIC_IP=change-me-to-your-linode-ip
CORS_ALLOW_ORIGINS=https://your-domain.com
FRONTEND_BASE_URL=https://your-domain.com
VITE_APP_URL=https://your-domain.com

# ── Frontend build (baked at build time — rebuild fe after changing) ─────────
# Environment the FE build targets: development | uat | production
# uat/development -> dev slot bounds (12 AM–11:59 PM); production -> 9 AM–7 PM
VITE_APP_ENV=production
# Preset slot duration in minutes shown on the booking page: UAT = 1, PROD = 30
VITE_SLOT_DURATION_MINUTES=30
    

# ── App Config ──────────────────────────────────────────────────────────────
# Environment: development | uat | production
# development/uat/staging -> dev-like timings (reminder ~10s, escalation ~20s, expiry 24h, 3s cron)
# production -> prod timings (reminder 2h, escalation 3h, expiry 24h, hourly cron)
APP_ENV=production
LOG_LEVEL=INFO

# ── Container timezone (log timestamps) ──────────────────────────────────────
# Used for docker log timestamps across all containers (BE, workers, AI, MCP,
# nginx, postgres). DB timestamps and API payloads stay UTC regardless.
# Override with a full IANA name, e.g. TZ=UTC.
TZ=Asia/Kolkata

# ── MCP Tool Server ───────────────────────────────────────────────────────────
# Fallback Bearer credential the MCP server uses when calling talentos-backend
# when NO caller Authorization header is present. When the AI chat assistant is
# the caller, the chat user's own JWT is forwarded end-to-end (BE -> AI -> MCP)
# and used instead, so requests run as that user. Keep this token for
# local/direct MCP invocations and non-AI callers.
TALENTOS_BACKEND_TOKEN=

# ── Form timing overrides (OPTIONAL) ─────────────────────────────────────────
# Only set these to override the APP_ENV defaults above.
# When unset, APP_ENV decides: uat/development = 0.002778 / 0.005556 / 24, production = 2 / 3 / 24.
# FORM_REMINDER_HOURS=2
# FORM_ESCALATION_HOURS=3
# FORM_EXPIRY_HOURS=24
# AI_ROUND_EVALUATION_DELAY_MINUTES=0

# ── Database (Local Postgres) ───────────────────────────────────────────────
DATABASE_URL=postgresql://talentos:change_me@postgres:5432/talentos

POSTGRES_USER=talentos
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=talentos

# ── Supabase (used ONLY for one-time data migration to local Postgres) ───────
SUPABASE_URL=postgresql://postgres:password@aws-0.ap-south-1.pooler.supabase.com:6543/postgres
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_WEBHOOK_SECRET=
SUPABASE_FUNCTIONS_BASE_URL=https://xxxxx.supabase.co/functions/v1

# ── LLM ────────────────────────────────────────────────────────────────────
# Provider switch: "openai" or "groq"
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
GROQ_API_KEY=gsk-your-groq-key
MODEL_NAME=gpt-5.4-mini
EVALUATION_MODEL_NAME=gpt-5.4-nano

# ── Google OAuth (user login) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=

# ── Google Calendar (service account with domain-wide delegation) ───────────
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_IMPERSONATION_EMAIL=
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata

# ── Recruithub (co-located) ────────────────────────────────────────────────
# TalentOS BE calls Recruithub over Docker DNS. Seeded into OpenBao.
RH_SERVICE_URL=http://rh-api:8000
RH_API_KEY=
SERVICE_API_KEY=

# ── JWT / encryption (OpenBao → be) ────────────────────────────────────────
JWT_SECRET=generate-a-random-secret-at-least-32-chars
SECRETS_ENCRYPTION_KEY=

# ── MeetMind ────────────────────────────────────────────────────────────────
MEETMIND_BASE_URL=
MEETMIND_API_TOKEN=
MEETMIND_WEBHOOK_SECRET=

# ── SMTP / Email ────────────────────────────────────────────────────────────
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ── OpenBao dev namespace overrides (local dev) ─────────────────────────────
# OpenBao keeps two INDEPENDENT environments: `talentos/` + `ai/` seed the
# UAT/deployed stack from the values above, while `dev/` + `ai-dev/` seed the
# local-dev setup. Every DEV_<KEY> below overrides that key's value for the dev
# namespace; leave a DEV_* unset to mirror the uat value (still stored as its
# own separate entry). At minimum DEV_DATABASE_URL / DEV_DATABASE_URI should
# point at the Supabase your local dev connects to.
# DEV_JWT_SECRET=
# DEV_SECRETS_ENCRYPTION_KEY=
DEV_DATABASE_URL=
DEV_RESEND_API_KEY=
# DEV_SMTP_USERNAME=
# DEV_SMTP_PASSWORD=
# DEV_GOOGLE_CLIENT_SECRET=
# DEV_GOOGLE_SERVICE_ACCOUNT_JSON=
# DEV_GOOGLE_IMPERSONATION_EMAIL=
# DEV_MEETMIND_API_TOKEN=
# DEV_MEETMIND_WEBHOOK_SECRET=
# DEV_SUPABASE_SERVICE_ROLE_KEY=
# DEV_SUPABASE_WEBHOOK_SECRET=
# DEV_RH_API_KEY=
# DEV_SERVICE_API_KEY=
# DEV_OPENAI_API_KEY=
# DEV_GROQ_API_KEY=
DEV_DATABASE_URI=
